# GQYOS Mako Notification Config

max-visible=5
max-history=100
sort=-time

width=350
height=150
margin=10
padding=15
border-size=2
border-radius=10

background-color=#1e1e2ecc
text-color=#cdd6f4
border-color=#cba6f7

default-timeout=5000
default-delay=100

[urgency=low]
border-color=#a6e3a1

[urgency=normal]
border-color=#89b4fa

[urgency=high]
border-color=#f38ba8
default-timeout=0
